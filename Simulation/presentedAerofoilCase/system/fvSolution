FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }

    pFinal
    {
        $p;
        relTol          0;
    }
    
    pcorr
    {
        $pFinal;
    }

    "(rho|U|nuTilda|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    "(rho|U|nuTilda|e)Final"
    {
        $U;
        relTol          0;
    }
}

SIMPLE
{
    residualControl
    {
        p               1e-4;
        U               1e-4;
        "(nuTilda|e)"   1e-4;
    }

    nNonOrthogonalCorrectors 1;
    pMinFactor      0.1;
    pMaxFactor      2;
}

PIMPLE
{

    nOuterCorrectors         10;   // increase — LTS needs more pseudo-iterations
    nCorrectors              3;     // up from 2
    nNonOrthogonalCorrectors 2;     // up from 1 if mesh has non-orthogonality
    
    localTimestepping        true;
    maxCo                    3;   // drop to 0.3–0.5 near shocks; 1.0 is too high
    maxDeltaT                1e-5;  // tighten this

    rDeltaTSmoothingCoeff    0.05;  // reduce from 0.2 — less smoothing = more local resolution
    rDeltaTDampingCoeff      0.95;  // increase toward 1.0 for stronger damping
    
    // Add these if not present:
    rDeltaTFactorIncrease    1.1;   // slow ramp-up of pseudo-dt
    rDeltaTFactorDecrease    0.9;
    

/*
    correctPhi              yes;
    nCorrectors              3;
    nNonOrthogonalCorrectors 1;
    nOuterCorrectors         10;
    pMinFactor      0.1;
    pMaxFactor      2;
*/  
    residualControl
    {
        rho
        {
            tolerance 5e-7;
            relTol    0;
        }

        p
        {
            tolerance 5e-7;
            relTol    0;
        }

        U
        {
            tolerance 5e-7;
            relTol    0;
        }

        e
        {
            tolerance 5e-7;
            relTol    0;
        }

        "(k|omega|epsilon)"
        {
            tolerance 5e-7;
            relTol    0;
        }
    }
}

relaxationFactors
{

    fields
    {
        ".*"     0.3;
    }
    equations
    {
        ".*"     0.4;
    }
}

