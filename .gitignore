# =========================================
# OpenFOAM .gitignore
# =========================================

# --- Processor directories (parallel runs) ---
processor*/

# --- Time directories (keep 0/ for initial conditions) ---
# Uncomment the next line to ignore ALL time directories including 0/
# [0-9]*/
# Ignore all numeric time directories except 0/
[1-9]*/
[1-9][0-9]*/
[1-9][0-9][0-9]*/
[1-9][0-9][0-9][0-9]*/
0.[0-9]*/

# --- Mesh files (generated by blockMesh, snappyHexMesh, etc.) ---
constant/polyMesh/
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh

# Keep triSurface STL/OBJ geometry files
!constant/triSurface/*.stl
!constant/triSurface/*.obj
!constant/triSurface/*.nas

# --- Post-processing and results ---
postProcessing/
VTK/
*.vtk
*.vtu
*.vtp
*.pvd
*.foam
sets/
graphs/
images/
probes/

# --- Log files ---
log.*
log
*.log
logs/

# --- Foam output files ---
*.OpenFOAM

# --- ParaView ---
*.pvsm
*.pvstate

# --- PyFoam ---
*.analyzed
*.pickledPlots
PyFoamState.TheState
PyFoamState.*.TheState
*.pyFoamServerSocket

# --- GNU Screen / job output ---
screenlog.*
nohup.out
slurm-*.out
jobOutput*

# --- dynamicCode (runtime-compiled functions) ---
dynamicCode/

# --- Temporary and backup files ---
*.orig
*.bak
*~
\#*\#

# --- OS files ---
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Editor files ---
.vscode/
.idea/
*.swp
*.swo
